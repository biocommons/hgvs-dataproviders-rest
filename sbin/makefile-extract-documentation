#!/usr/bin/env python3
"""Print help text from Makefile section headers and target descriptions."""

import re
import sys
from pathlib import Path

for makefile in sys.argv[1:]:
    with Path(makefile).open() as source:
        for line in source:
            if match := re.match(r"#= (.+)", line):
                print(f"\n{match.group(1)}")
            elif match := re.match(r"([\w-]+):.+?##\s+(.+)", line):
                print(f"{match.group(1):<20}{match.group(2)}")
